.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build directories
dist/
build/
out/

# Coverage directory used by tools like istanbul
coverage/

# TypeScript
*.tsbuildinfo

# Parcel-bundler cache
.cache/

# SvelteKit build output
.svelte-kit/

# Storybook build output
.out/
storybook-static/

# Static site generators
public/

